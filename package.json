{
  "name": "marco-portfoli",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://marcbasas.com",
  "scripts": {
    "dev": "vite",
    "admin-server": "node admin/server/server.js",
    "admin-dev": "nodemon admin/server/server.js",
    "check-server": "node admin/scripts/check-server.js",
    "build": "vite build && copy dist\\index.html dist\\404.html",
    "postbuild": "react-snap",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "install-render": "npm install --legacy-peer-deps"
  },
  "reactSnap": {
    "source": "dist",
    "include": [
      "/",
      "/about",
      "/project/kumo-creative-project",
      "/project/cinevision-studios",
      "/project/constellations",
      "/project/hobo",
      "/project/chessExcel",
      "/project/crealab",
      "/project/portfolio-demo"
    ],
    "removeStyleTags": false,
    "puppeteerArgs": [
      "--no-sandbox",
      "--disable-features=VizDisplayCompositor",
      "--disable-dev-shm-usage"
    ],
    "waitForSelector": "body",
    "skipThirdPartyRequests": true,
    "concurrency": 1,
    "timeout": 30000,
    "viewport": {
      "width": 1200,
      "height": 800
    }
  },
  "dependencies": {
    "@babel/runtime": "^7.27.0",
    "@codemirror/lang-css": "^6.1.0",
    "@codemirror/lang-html": "^6.2.0",
    "@codemirror/lang-javascript": "^6.1.4",
    "@codemirror/state": "^6.2.1",
    "@codemirror/view": "^6.2.0",
    "@uiw/codemirror-themes": "^4.23.10",
    "@uiw/codemirror-themes-all": "^4.23.10",
    "archiver": "^6.0.2",
    "bcrypt": "^5.1.1",
    "bootstrap": "^5.3.5",
    "codemirror": "^6.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "gsap": "^3.13.0",
    "i18next": "^25.5.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.503.0",
    "multer": "^1.4.5-lts.1",
    "prop-types": "^15.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": "^2.0.5",
    "react-i18next": "^15.7.3",
    "react-router-dom": "^7.5.0",
    "smooth-scrollbar": "^8.8.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "gh-pages": "^6.3.0",
    "globals": "^15.15.0",
    "nodemon": "^3.0.1",
    "react-snap": "^1.23.0",
    "vite": "^6.2.0",
    "vite-plugin-sitemap": "^0.8.2"
  }
}
