# Configuración para Render
# Variables de entorno que debes configurar en Render

# PIN de acceso al panel de administración (4-6 dígitos recomendados)
ADMIN_PIN=123456

# Clave secreta para JWT (genera una clave aleatoria segura)
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=tu-clave-secreta-muy-larga-aqui

# Puerto del servidor (Render lo asigna automáticamente)
PORT=10000

# Tiempo de expiración de la sesión en horas
SESSION_DURATION_HOURS=24

# Entorno de producción
NODE_ENV=production
